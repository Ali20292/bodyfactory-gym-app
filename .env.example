# ---------------------------------------------------------------
# Gym App — environment template
#
# Copy this to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` MUST be in .gitignore. This `.env.example` is the only one
# that gets committed.
#
# WARNING: nothing here is secret. Anything bundled into a Flutter
# build is extractable from the APK/IPA. Never put database
# credentials, admin keys, or SMS provider secrets in this file —
# those belong in the backend's own environment, on the server.
# ---------------------------------------------------------------

# Master switch for the data layer.
# true  = all repositories use in-memory dummy data, no network calls
# false = repositories hit the real backend at API_BASE_URL
USE_MOCK_DATA=true

# Backend API root. Ignored while USE_MOCK_DATA=true.
# Android emulator reaches your machine's localhost at 10.0.2.2
API_BASE_URL=http://10.0.2.2:8080/api/v1

# Network timeouts, milliseconds
API_CONNECT_TIMEOUT_MS=10000
API_RECEIVE_TIMEOUT_MS=15000

# dev | staging | prod — drives logging verbosity and error reporting
APP_ENV=dev

# Verbose HTTP logging. Must be false for release builds.
ENABLE_HTTP_LOGGING=true

# How often the Home tab refreshes the capacity bar, seconds
CAPACITY_REFRESH_INTERVAL_SECONDS=60

# Fallback max occupancy, used only by the mock repository and as a
# display fallback if the API response is missing maxCapacity.
# The real value is authoritative on the backend.
GYM_MAX_OCCUPANCY_FALLBACK=120

# Session window in minutes — how long after check-in a member is
# assumed to still be in the gym. Mirrors the backend's
# SESSION_WINDOW_MINUTES; used by the mock repository's simulation.
SESSION_WINDOW_MINUTES=75

# OTP behaviour — must match the backend's configured values
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60

# Optional crash reporting. Leave blank to disable.
SENTRY_DSN=

# ---------------------------------------------------------------
# Loading these values
#
# This project uses Option A — compile-time dart-defines:
#     flutter run   --dart-define-from-file=.env
#     flutter build --dart-define-from-file=.env
#
# Read them through lib/core/config/app_config.dart, never through
# String.fromEnvironment scattered across the codebase.
#
# Keys are wired one-for-one in AppConfig; every one has a fallback,
# so the app still builds on dummy data with no .env present.
# ---------------------------------------------------------------
