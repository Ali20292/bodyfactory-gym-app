<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-mode counterpart. The brand mark is near-black in both themes, so
     the splash looks identical either way. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/brand_black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launch_logo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
